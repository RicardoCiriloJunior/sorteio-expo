DATABASE_URL=postgresql+psycopg://sorteio:sorteio@localhost:5432/sorteio
# Aceita tambem postgresql://, postgres:// e jdbc:postgresql:// (ex.: Neon).
# SSL e channel binding sao preservados; channelBinding e convertido para channel_binding.
# Gere dois valores diferentes com: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET=
ADMIN_KEY=
PUBLIC_BASE_URL=http://localhost:3000
# JSON com as origens exatas do frontend, se estiver em outro dominio/porta.
CORS_ORIGINS=["http://localhost:3000"]
# Credenciais usadas somente pelo comando de cadastro dos estandes (minimo 6 caracteres).
OUROS_PIN=
CERIS_PIN=
ECOCIENTE_PIN=
APOLLO_PIN=
